---
config:
  flowchart:
    curve: basis
---
%% Data Flow Diagram of Executable Python Scripts
%% Updated to match the current ephem-toolkit command set and data formats.
%%
%% Legend:
%%   Rounded rectangles ([...]) = executable scripts
%%   Hexagons {{...}} = data formats
%%   Cartesian = instantaneous position and velocity state vectors
%%   Osculating Keplerian = instantaneous classical elements
%%   Mean Keplerian = theory-specific averaged elements
%%   Cartesian histories retain their originating propagation model and are
%%   not interchangeable merely because they share the same state-vector layout
%%   Arrows show data flow direction with format labels

flowchart LR

    %% ===== Data Format Nodes =====
    fmt_tle{{"TLE (.tle) <br/> Mean Keplerian elements <br/> SGP4-compatible"}}
    fmt_omm{{"OMM (.omm) <br/> Mean Keplerian elements <br/> Theory: SGP4, Brouwer, DSST, etc."}}
    fmt_opm{{"OPM (.opm) <br/> Cartesian state (mandatory) <br/> Optional osculating Keplerian elements"}}
    fmt_oem{{"Input OEM / State Vectors <br/> Cartesian state history <br/> (epoch x y z vx vy vz)"}}
    fmt_oem_pair{{"Two CCSDS OEM histories <br/> Reference + comparison"}}
    fmt_plot_inputs{{"One or more OEM / raw-state files <br/> First file is the reference"}}
    fmt_oem_mean{{"Cartesian state history <br/> Generated from mean-element input <br/> (SGP4, DSST, or Kepler fallback)"}}
    fmt_oem_osculating{{"Cartesian state history <br/> Generated from osculating Keplerian elements <br/> (two-body Kepler propagation)"}}
    fmt_oem_numerical{{"Cartesian state history <br/> Generated by numerical propagation <br/> (force-model dependent)"}}
    fmt_dep_vars_csv{{"Dependent Variables CSV"}}
    fmt_raw_states{{"Raw Cartesian state lines <br/> (epoch x y z vx vy vz)"}}
    fmt_text_report{{"Text report / comparison table <br/> (stdout)"}}
    fmt_other_gp{{"Other CelesTrak GP formats <br/> (XML, JSON, CSV, etc.)"}}
    fmt_plots{{"Plots / Animations <br/> (Matplotlib figures)"}}
    fmt_aer_text{{"AER Text <br/> (stdout)"}}
    fmt_celestrak{{"CelesTrak<br/>(HTTP download)"}}

    %% ===== Script Nodes =====
    download_tle(["download-tle"])
    omm_to_tle(["omm-to-tle"])
    tle_to_omm(["tle-to-omm"])
    tle_info(["tle-info"])
    oem_to_opm(["oem-to-opm"])
    oem_to_omm(["oem-to-omm"])
    oem_to_tle(["oem-to-tle"])
    omm_to_opm(["omm-to-opm"])
    tle_to_opm(["tle-to-opm"])
    propagate_tle(["propagate-tle"])
    propagate_omm(["propagate-omm"])
    propagate_sat(["propagate-orbit"])
    propagate_kepler(["propagate-kepler"])
    diff_oem(["diff-oem"])
    plot_oem(["plot-oem"])
    plot_oem_diff(["plot-oem-diff"])
    plot_dep_vars(["plot-dependent-variables"])
    slice_oem(["slice-oem"])
    xform_oem(["xform-oem"])

    %% ===== Data Flows =====
    fmt_celestrak -->|"satellite ID"| download_tle
    download_tle -->|"default format"| fmt_tle
    download_tle -->|"--format omm"| fmt_omm
    download_tle -->|"other --format values"| fmt_other_gp

    fmt_oem -->|"Cartesian state history"| oem_to_opm
    oem_to_opm -->|"OPM Cartesian state; Keplerian elements in two-body mode"| fmt_opm

    fmt_oem -->|"Cartesian state history"| oem_to_omm
    oem_to_omm -->|"Brouwer / DSST / SGP4 mean Keplerian"| fmt_omm
    fmt_oem -->|"Cartesian state history"| oem_to_tle
    oem_to_tle -->|"SGP4 TLE (via intermediate OMM)"| fmt_tle

    fmt_omm -->|"SGP4-compatible mean Keplerian"| omm_to_tle
    omm_to_tle -->|"SGP4 mean Keplerian"| fmt_tle

    fmt_tle -->|"SGP4 mean Keplerian"| tle_to_omm
    tle_to_omm -->|"SGP4 mean Keplerian"| fmt_omm

    fmt_tle --> tle_info
    tle_info -->|"epoch, state, osculating elements"| fmt_text_report

    fmt_tle -->|"SGP4 mean Keplerian"| propagate_tle
    propagate_tle -->|"SGP4 Cartesian state history"| fmt_oem_mean

    fmt_omm -->|"mean elements + theory"| propagate_omm
    propagate_omm -->|"model-selected Cartesian state history"| fmt_oem_mean

    fmt_opm -->|"mandatory Cartesian initial state"| propagate_sat
    propagate_sat -->|"numerically propagated Cartesian state history"| fmt_oem_numerical
    propagate_sat -->|"--dep-vars (optional)"| fmt_dep_vars_csv

    fmt_opm -->|"Osculating Keplerian elements"| propagate_kepler
    propagate_kepler -->|"osculating-Keplerian Cartesian state history"| fmt_oem_osculating

    fmt_oem_pair -->|"exactly two: reference + comparison"| diff_oem
    diff_oem -->|"difference metrics / table"| fmt_text_report
    fmt_oem --> plot_oem
    fmt_plot_inputs -->|"reference + optional comparisons"| plot_oem_diff
    plot_oem --> fmt_plots
    plot_oem_diff --> fmt_plots

    fmt_oem --> slice_oem
    slice_oem -->|"Cartesian state history"| fmt_oem
    slice_oem -->|"--data-only"| fmt_raw_states
    slice_oem -->|"Cartesian-only single-state OPM"| fmt_opm

    fmt_dep_vars_csv --> plot_dep_vars
    plot_dep_vars --> fmt_plots

    fmt_oem -->|"Cartesian states + source and target frames"| xform_oem
    xform_oem -->|"converted Cartesian OEM"| fmt_oem
    xform_oem -->|"AER text"| fmt_aer_text

    %% ===== Composed convenience commands =====
    fmt_omm -->|"declared mean-element model"| omm_to_opm
    omm_to_opm -->|"reference OEM propagation + numerical fit"| fmt_opm
    fmt_tle -->|"SGP4 reference arc"| tle_to_opm
    tle_to_opm -->|"reference OEM propagation + numerical fit"| fmt_opm
