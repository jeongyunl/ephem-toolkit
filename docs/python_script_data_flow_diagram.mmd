---
config:
  flowchart:
    curve: basis
---
%% Data Flow Diagram of Executable Python Scripts
%% Shows how scripts connect through shared data formats (input → script → output)
%%
%% Legend:
%%   Rounded rectangles ([...]) = executable scripts
%%   Hexagons {{...}} = data formats
%%   Arrows show data flow direction with format labels

flowchart LR

    %% ===== Data Format Nodes =====
    fmt_tle{{"TLE (.tle)"}}
    fmt_omm{{"OMM (.omm)"}}
    fmt_oem{{"OEM / State Vectors <br/> (CCSDS OEM or simple format: epoch x y z vx vy vz)"}}
    fmt_kepler{{"OEM-like Keplerian Elements <br/> (epoch a e i ω Ω θ)"}}
    fmt_dep_vars_csv{{"Dependent Variables CSV"}}
    fmt_plots{{"Plots / Animations <br/> (Matplotlib figures)"}}
    fmt_aer_text{{"AER Text <br/> (stdout)"}}
    fmt_time{{"Time Values <br/> (ISO / POSIX / UTC / TAI / TT / TDB)"}}
    fmt_celestrak{{"CelesTrak<br/>(HTTP download)"}}

    %% ===== Script Nodes =====

    %% Utility command nodes
    download_tle(["download-tle"])
    omm_to_tle(["omm-to-tle"])
    tle_to_omm(["tle-to-omm"])
    tle_info(["tle-info"])
    oem_to_omm(["oem-to-omm"])
    propagate_tle(["propagate-tle"])
    propagate_sat(["propagate-orbit"])
    propagate_kepler(["propagate-kepler"])
    plot_dep_vars(["plot-dependent-variables"])
    plot_orbit_deltas(["plot-orbit-deltas"])
    slice_oem(["slice-oem"])
    xform_oem(["xform-oem"])
    convert_time(["convert-time"])
    convert_time2(["convert-time2"])

    %% ===== Data Flows =====

    %% download-tle: CelesTrak → TLE or OMM files
    fmt_celestrak -->|"satellite ID"| download_tle
    download_tle -->|"TLE format"| fmt_tle
    download_tle -->|"OMM format"| fmt_omm

    %% oem-to-omm: OEM state vectors → OMM (Keplerian or TLE)
    fmt_oem --> oem_to_omm
    oem_to_omm --> fmt_omm
    oem_to_omm --> fmt_tle

    %% omm-to-tle: OMM → TLE
    fmt_omm --> omm_to_tle
    omm_to_tle --> fmt_tle

    %% tle-to-omm: TLE → OMM
    fmt_tle --> tle_to_omm
    tle_to_omm --> fmt_omm

    %% tle-info: TLE → console summary
    fmt_tle --> tle_info

    %% propagate-tle: TLE → OEM-like state vectors
    fmt_tle --> propagate_tle
    propagate_tle --> fmt_oem

    %% propagate-orbit: single OEM state line → propagated outputs
    fmt_oem -->|"single state line"| propagate_sat
    propagate_sat -->|"state history"| fmt_oem
    propagate_sat -->|"dependent variables"| fmt_dep_vars_csv

    %% propagate-kepler: Keplerian elements → OEM state vectors
    fmt_kepler --> propagate_kepler
    propagate_kepler --> fmt_oem

    %% plot-orbit-deltas: OEM state files → plots
    fmt_oem --> plot_orbit_deltas
    plot_orbit_deltas --> fmt_plots

    %% slice-oem: OEM → sliced OEM states
    fmt_oem --> slice_oem
    slice_oem --> fmt_oem

    %% plot-dependent-variables: dependent-variable CSV → plots/animations
    fmt_dep_vars_csv --> plot_dep_vars
    plot_dep_vars --> fmt_plots

    %% xform-oem: OEM frame conversion or ECEF position-to-AER conversion
    fmt_oem -->|"source frame + target frame"| xform_oem
    xform_oem -->|"converted OEM"| fmt_oem
    xform_oem -->|"AER text"| fmt_aer_text

    %% convert-time: time values → converted time values
    fmt_time --> convert_time
    convert_time --> fmt_time

    %% convert-time2: time values → converted time values
    fmt_time --> convert_time2
    convert_time2 --> fmt_time
