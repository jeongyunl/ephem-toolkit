flowchart TB
    %% Widget hierarchy of the play-oem window (wxPython).
    %% Arrows run from parent to child. Edge labels give the position inside the parent.
    %% Sizers are not drawn as nodes; their layout is described in the widget labels.

    frame["Main window<br/>wx.Frame"]
    frame --> menu_bar["wx.MenuBar<br/>File → Open File..."]
    frame --> main_sizer["main_sizer (vertical)"]
    frame --> status_bar["wx.StatusBar<br/>load result and error messages"]
    frame --> playback_timer["wx.Timer<br/>1–30 FPS selected in Settings pane<br/>elapsed frame periods advance the clock<br/>overrun redraws are dropped"]

    main_sizer -- "top, stretch 1" --> main_splitter
    main_sizer -- "bottom, fixed height" --> timeline_panel

    main_splitter["self.main_splitter<br/>wx.SplitterWindow, vertical sash<br/>left pane minimum 240 px"]
    main_splitter -- "left" --> controls_pane
    main_splitter -- "right" --> graph_panes_splitter

    subgraph LEFT ["Controls and Info pane"]
        controls_pane["self.controls_pane<br/>wx.Panel, Controls &amp; Info"]
        controls_pane --> controls_title_label["self.controls_title_label<br/>wx.StaticText"]
        controls_pane --> rail["feature_button_rail (sizer)<br/>self.feature_rail_buttons: 4 x wx.BitmapToggleButton<br/>Settings, OEM file information, Ground Stations, State"]
        controls_pane --> feature_book["self.feature_book<br/>wx.Simplebook, one page per feature"]

        feature_book -- "Settings" --> settings_page["self.settings_page<br/>wx.Panel"]
        feature_book -- "OEM file information" --> info_page["self.file_info_page<br/>wx.Panel"]
        feature_book -- "Ground Stations" --> ground_stations_page["self.ground_stations_page<br/>wx.Panel"]
        feature_book -- "State" --> state_page["self.state_page<br/>wx.Panel"]

        settings_page --> settings_panel["ControlWindow.settings_scroller<br/>wx.ScrolledWindow, vertical scroll"]
        settings_panel --> time_zone["Display time zone<br/>UTC or Local Time Zone"]
        settings_panel --> time_snapping["Time snapping<br/>Snap plots to UTC half-seconds"]
        settings_panel --> render_rate["render_rate_label (1–30 FPS, default 30),<br/>render_rate_slider"]
        settings_panel --> interpolation["Interpolation source, method,<br/>degree, and active-policy status"]

        info_page --> info_scroll["self.file_info_scroll<br/>wx.ScrolledWindow, vertical scroll"]
        info_scroll --> info_labels["OEM file context and metadata headings and labels"]

        ground_stations_page --> station_manager["GroundStationsManager"]
        station_manager --> station_scroll["wx.ScrolledWindow<br/>Ground Stations manager"]
        station_scroll --> station_add["Add Ground Station button"]
        station_scroll --> station_rows["Station rows<br/>expandable wx.ToggleButton"]
        station_rows --> station_editor["Inline editor<br/>name, coordinates, altitude,<br/>elevation mask, validation, Save/Cancel/Remove"]

        state_page --> state_scroller["ControlWindow.state_scroller<br/>wx.ScrolledWindow, vertical scroll"]
        state_scroller --> state_labels["state_position_label, state_velocity_label,<br/>state_derived_label, state_cursor_status_label"]
    end

    subgraph DATA_VIEWS ["Data-view area"]
        graph_panes_splitter["self.data_view_panes_splitter<br/>wx.SplitterWindow, vertical sash<br/>Additional pane unsplit until toggled"]
        graph_panes_splitter -- "left" --> main_pane
        graph_panes_splitter -- "right, when shown" --> additional_pane

        main_pane["self.main_pane<br/>wx.Panel, Main pane"]
        main_pane --> middle_header["header title, Add data view,<br/>View preset, Additional pane, Follow selection"]
        main_pane --> main_stack["self.main_stack<br/>wx.ScrolledWindow, vertical scroll"]

        additional_pane["self.additional_pane<br/>wx.Panel, Additional pane, hidden by default"]
        additional_pane --> right_header["header title, Add data view,<br/>Close pane"]
        additional_pane --> additional_stack["self.additional_stack<br/>wx.ScrolledWindow, vertical scroll"]

        main_stack --> middle_empty["empty_state_panel, empty_state_label,<br/>add_data_view_button<br/>(shown when there are no data views)"]
        main_stack --> middle_tree["Panel tree<br/>nested horizontal wx.SplitterWindow<br/>with one DataViewPanelHost per data view"]
        main_stack --> middle_handle["bottom_resize_handle<br/>wx.Panel, 6 px tall, vertical resize cursor"]

        additional_stack --> right_empty["empty_state_panel, empty_state_label,<br/>add_data_view_button"]
        additional_stack --> right_tree["Panel tree, same as Main pane"]
        additional_stack --> right_handle["bottom_resize_handle (Additional pane)"]

        middle_tree --> view_panel["DataViewPanelHost<br/>wx.Panel, one per data view"]
        view_panel --> host_header["data_view_selector (wx.Choice) or data_view_title_label,<br/>Actions menu button, Close button"]
        view_panel --> data_view_scroller["data_view_scroller<br/>wx.ScrolledWindow, horizontal and vertical scroll"]
        data_view_scroller --> view_content["MatplotlibPanel<br/>FigureCanvasWxAgg and optional toolbar<br/>or native wx content or empty_data_view_prompt"]
    end

    subgraph TIMELINE ["Bottom strip"]
        timeline_panel["self.timeline_panel<br/>wx.ScrolledWindow"]
        timeline_panel --> timeline_separator["wx.StaticLine<br/>visual boundary above timeline"]
        timeline_panel --> time_row["time_readout_row<br/>start label, current time prefix and entry,<br/>error label, and end label"]
        timeline_panel --> playback_controls_row["playback_sizer<br/>reverse speed presets, reverse play, forward play,<br/>forward speed presets, focus sink"]
        timeline_panel --> timeline_track_row["self.timeline_track_row<br/>wx.Panel, vertical TimeScrubber track"]
        timeline_track_row --> time_scrubber["self.time_scrubber<br/>TimeScrubberWidget (wx.Panel)"]
        time_scrubber --> timeline_left_chevron["self.timeline_left_chevron<br/>pan earlier"]
        time_scrubber --> time_scrubber_column["slider and tick rail column"]
        time_scrubber_column --> timeline_slider["self.timeline_slider<br/>PlaybackTimeScrubber (custom wx.Control)<br/>zoomable track, coverage, playback/plot grips"]
        time_scrubber_column --> timeline_tick_rail["self.timeline_tick_rail<br/>adaptive major and minor UTC ticks"]
        time_scrubber --> timeline_right_chevron["self.timeline_right_chevron<br/>pan later"]
        timeline_panel --> timeline_grips["Sibling pointer/keyboard grips<br/>playback bounds, plot endpoints,<br/>current-time marker"]
    end

    classDef window fill:#dbeafe,stroke:#1e40af,color:#1e293b
    classDef container fill:#e5e7eb,stroke:#374151,color:#1f2937
    classDef scroller fill:#dcfce7,stroke:#166534,color:#14532d
    class frame window
    class main_splitter,graph_panes_splitter container
    class settings_panel,state_scroller,info_scroll,main_stack,additional_stack,data_view_scroller scroller
