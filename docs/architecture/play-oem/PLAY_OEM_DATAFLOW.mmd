flowchart TD
    FILE[("OEM file")]

    subgraph WORKER["Loader / preparation thread"]
        direction TB
        PARSE["read_oem_batches<br/>parse OEM epochs"]
        PREP["IncrementalPlaybackPreparer<br/>AppendablePlaybackData"]
        SERIES["OrbitSeriesAccumulator<br/>compute_orbit_series on new rows"]
        CURSOR["OemCursor<br/>timestamps, states, segments<br/>interpolation support"]
        SOURCE["GroundTrackSource<br/>growing OEM sample prefix"]
        PARSE --> PREP
        PREP --> SERIES
        PREP --> CURSOR
        CURSOR --> SOURCE
    end

    subgraph UI["wx UI thread"]
        direction TB
        POLL["_poll_incremental_load<br/>install prepared batches"]
        THROTTLE["Refresh throttling<br/>at most every 5 s while loading<br/>forced on completion"]
        INPLACE["_update_incremental_panel_data<br/>reuse compatible views / figures"]
        FALLBACK["Rebuild incompatible<br/>or structurally changed views"]
        DEFER["Defer Access / Passes<br/>until completion"]
        POLL --> THROTTLE
        THROTTLE --> INPLACE
        INPLACE -.->|"not compatible"| FALLBACK
        THROTTLE -.->|"station panels"| DEFER
    end

    subgraph VIEWS["Range-limited graph preparation"]
        direction TB
        SERIESV["State Components, Speed / Altitude,<br/>RTN Deltas, Angular Velocity,<br/>Direction Change, Geocentric Distance"]
        TRAJ["3D Orbit<br/>range selection + decimation<br/>Matplotlib or VTK"]
        TRACK["Ground Track<br/>range + margin"]
        ACCESS["Station Status, Pass Strip,<br/>Elevation / Azimuth / Range Profiles,<br/>Pass List, Sky View"]
        PASS_TRACK["Pass Ground Track<br/>selected pass interval"]
    end

    subgraph SHARED["Shared range intermediates and caches"]
        direction TB
        POSCACHE[("EarthFixedPositionCache<br/>shared ITRF sample positions")]
        GEODETIC["GroundTrackCoordinates<br/>WGS-84 latitude / longitude"]
        ACCESSCACHE[("StationAccessCache<br/>per-station results by analysis window")]
        PROFILES["Look-angle profiles<br/>time, azimuth, elevation, range"]
        INTERVALS["Access intervals<br/>pass bounds and summary metrics"]
        FOOTPRINTS["Footprints<br/>current ECEF position + elevation mask"]
    end

    subgraph FRAME["Per playback frame"]
        direction TB
        TICK["clock.tick"]
        LOOK["cursor.lookup"]
        CURRENT["Current state"]
        CURRENT_ECEF["Current ITRF / ECEF position"]
        TICK --> LOOK --> CURRENT --> CURRENT_ECEF
    end

    RANGE{{"Active plot range<br/>default follows first two playback days<br/>saved settings override"}}
    FILE --> PARSE
    SERIES --> POLL
    SOURCE --> POLL
    INPLACE --> SERIESV
    INPLACE --> TRAJ
    INPLACE --> TRACK
    DEFER --> ACCESS
    INPLACE --> PASS_TRACK
    FALLBACK --> SERIESV
    FALLBACK --> TRAJ
    FALLBACK --> TRACK
    FALLBACK --> ACCESS
    FALLBACK --> PASS_TRACK
    RANGE --> SERIESV
    RANGE --> TRAJ
    RANGE --> TRACK
    RANGE --> ACCESS
    RANGE --> PASS_TRACK
    SOURCE --> POSCACHE
    TRACK -->|"requests ITRF samples"| POSCACHE
    PASS_TRACK -->|"requests pass-bounded ITRF samples"| POSCACHE
    POSCACHE --> GEODETIC
    GEODETIC --> TRACK
    GEODETIC --> PASS_TRACK
    ACCESS -->|"requests station analysis"| ACCESSCACHE
    CURSOR --> ACCESSCACHE
    POSCACHE -->|"reuses sample positions"| ACCESSCACHE
    ACCESSCACHE --> PROFILES
    ACCESSCACHE --> INTERVALS
    PROFILES --> ACCESS
    INTERVALS --> ACCESS
    INTERVALS -->|"selected interval"| PASS_TRACK
    CURRENT_ECEF --> TRACK
    CURRENT_ECEF --> FOOTPRINTS
    FOOTPRINTS --> TRACK
    LOOK --> TRAJ
    CURRENT_ECEF -->|"station_metrics_from_ecef"| ACCESS
    SERIES --> SERIESV
    SERIES --> TRAJ

    classDef hot fill:#fdd,stroke:#c33,stroke-width:2px
    classDef retained fill:#dfd,stroke:#393
    class PARSE,ACCESS hot
    class INPLACE,POSCACHE,ACCESSCACHE,PROFILES,INTERVALS retained
