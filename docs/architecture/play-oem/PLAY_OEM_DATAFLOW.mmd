flowchart TD
    FILE[("OEM file")]

    subgraph WORKER["Default loader path"]
        direction TB
        CAPACITY["Optional capacity scan"]
        PARSE["read_oem_into_store<br/>parse state rows"]
        COMMIT["Reserve, fill, validate,<br/>commit raw rows"]
        RAW_EVENT["Generation-tagged<br/>raw-append event"]
        COMPLETE["Validated completion<br/>and metadata"]
        CAPACITY --> PARSE
        PARSE --> COMMIT
        COMMIT --> RAW_EVENT
        PARSE --> COMPLETE
    end

    subgraph STORE["OemDataStore"]
        direction TB
        RAW["Raw tier<br/>times, states, segments, metadata"]
        POLICY["Interpolation policy<br/>and point-state evaluator"]
        SERIES["Lazy series chunks<br/>named 2D history groups"]
        EARTH_FIXED["Lazy Earth-fixed<br/>ITRF position chunks"]
        GROUND_TRACK["Ground Track tier<br/>range-bounded WGS-84 groups"]
        ACCESS["Station-access tier<br/>profiles and intervals"]
        FOOTPRINT["Bounded footprints<br/>from point state and elevation mask"]
        SCHEDULER["Range hints and<br/>prioritized prefetch"]
        RAW --> POLICY
        RAW --> SERIES
        RAW --> EARTH_FIXED
        EARTH_FIXED --> GROUND_TRACK
        POLICY --> ACCESS
        POLICY --> FOOTPRINT
        EARTH_FIXED --> FOOTPRINT
        SCHEDULER --> SERIES
        SCHEDULER --> EARTH_FIXED
        SCHEDULER --> GROUND_TRACK
        SCHEDULER --> ACCESS
        SCHEDULER --> FOOTPRINT
    end

    subgraph APP["wx application"]
        direction TB
        CONTROLLER["Controller<br/>generation and event handling"]
        CONTEXT["StoreViewContext<br/>snapshot, range, coverage"]
        CLOCK["PlaybackClock<br/>store-backed sample times"]
        RANGE["Playback and plot<br/>range hints"]
        TIER_NOTICE["Append, reset, and<br/>tier notices"]
        CONTROLLER --> CONTEXT
        CONTROLLER --> CLOCK
        CONTROLLER --> RANGE
        RAW --> TIER_NOTICE
        SERIES --> TIER_NOTICE
        EARTH_FIXED --> TIER_NOTICE
        GROUND_TRACK --> TIER_NOTICE
        ACCESS --> TIER_NOTICE
        FOOTPRINT --> TIER_NOTICE
        TIER_NOTICE --> CONTROLLER
    end

    subgraph VIEWS["Store-backed views"]
        direction TB
        HISTORIES["2D histories<br/>State, kinematics, RTN,<br/>direction rates, distance"]
        TRAJECTORY["3D Orbit<br/>bounded raw display path"]
        TRACK_VIEW["Ground Track"]
        STATION_VIEWS["Station Status, Pass Strip,<br/>profiles, Pass List, Sky View"]
        PASS_TRACK["Pass Ground Track"]
        CURRENT_METRICS["Current station metrics"]
    end

    FILE --> CAPACITY
    COMMIT --> RAW
    RAW_EVENT --> CONTROLLER
    COMPLETE --> CONTROLLER
    RANGE --> CONTEXT
    RANGE --> SCHEDULER
    CONTEXT --> SERIES
    CONTEXT --> GROUND_TRACK
    CONTEXT --> ACCESS
    CONTEXT --> FOOTPRINT
    CONTEXT --> RAW
    RAW -->|"read-only position, time, segment views"| TRAJECTORY
    CLOCK -->|"state_at(t)"| POLICY
    POLICY --> TRAJECTORY
    POLICY --> CURRENT_METRICS
    POLICY --> FOOTPRINT
    SERIES --> HISTORIES
    GROUND_TRACK --> TRACK_VIEW
    GROUND_TRACK --> PASS_TRACK
    ACCESS --> STATION_VIEWS
    ACCESS -->|"selected access interval"| PASS_TRACK
    FOOTPRINT --> TRACK_VIEW
    CURRENT_METRICS --> STATION_VIEWS

    subgraph LEGACY["Prepared-batch compatibility path (not the default)"]
        direction TB
        BATCH["read_oem_batches"]
        PREPARE["IncrementalPlaybackPreparer<br/>AppendablePlaybackData"]
        OWNERS["OrbitSeriesAccumulator, OemCursor,<br/>GroundTrackSource, station caches"]
        BATCH --> PREPARE --> OWNERS
    end

    classDef store fill:#e8f1ff,stroke:#2463a6,stroke-width:2px
    classDef view fill:#f4f4f4,stroke:#666
    classDef legacy fill:#eee,stroke:#888,stroke-dasharray:5 5
    class RAW,POLICY,SERIES,EARTH_FIXED,GROUND_TRACK,ACCESS,FOOTPRINT store
    class HISTORIES,TRAJECTORY,TRACK_VIEW,STATION_VIEWS,PASS_TRACK,CURRENT_METRICS view
    class BATCH,PREPARE,OWNERS legacy
